BASE <http://nesped1.caf.ufv.br/micelio/simulation/bikes>
PREFIX bikes: <http://nesped1.caf.ufv.br/micelio/simulation/bikes#>
PREFIX mcl: <http://nesped1.caf.ufv.br/micelio/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX qu: <http://purl.oclc.org/NET/ssnx/qu/qu#>
PREFIX unit: <http://purl.oclc.org/NET/ssnx/qu/unit#>
PREFIX tlc: <http://gessi.lsi.upc.edu/threelevelcontextmodelling/ThreeLContextOnt/UpperLevelOntology#>

bikes:BikeShareTask a mcl:LearningTaskLayout;
  mcl:hasTarget bikes:BikeShareDemand;
  mcl:hasFeature bikes:BikeShareEventsAggregate;
  mcl:hasPredictFilter """FILTER NOT EXISTS { ?ctx bikes:demand ?demand  }""";
  .

bikes:BikeShareDemand a owl:Class;
  mcl:visibility mcl:Public;
  rdfs:subClassOf
    tlc:State,
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:hourSlot;
      mcl:onRange xsd:dateTimeStamp;
      mcl:isKey true;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty mcl:locatedAt;
      mcl:onRange bikes:Station;
      mcl:isKey true;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:demand;
      mcl:onRange xsd:nonNegativeInteger;
    ];
  mcl:derived [
    mcl:onDomain bikes:BikeShareEvent;
    mcl:query """?ctx bikes:demand ?demand."""];
  .

bikes:BikeShareEventsAggregate a owl:Class;
  mcl:visibility mcl:Public;
  rdfs:subClassOf
    tlc:State,
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:hourSlot;
      mcl:onRange xsd:dateTimeStamp;
      mcl:isKey true;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty mcl:locatedAt;
      mcl:onRange bikes:Station;
      mcl:isKey true;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty mcl:latitude;
      mcl:onRange xsd:double;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty mcl:longitude;
      mcl:onRange xsd:double;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:isHoliday;
      mcl:onRange xsd:boolean;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:isWeekend;
      mcl:onRange xsd:nonNegativeInteger;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:month;
      mcl:onRange xsd:nonNegativeInteger;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:hour;
      mcl:onRange xsd:nonNegativeInteger;
    ],
    # [
    #   a mcl:WithAttribute;
    #   mcl:onProperty bikes:weatherCondition;
    #   mcl:onRange bikes:WeatherCode;
    # ],
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:temperature;
      mcl:onRange xsd:double;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:relativeHumidity;
      mcl:onRange xsd:double;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:precipitation;
      mcl:onRange xsd:double;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:windSpeed;
      mcl:onRange xsd:double;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:cloudCoverage;
      mcl:onRange xsd:double;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:airPressure;
      mcl:onRange xsd:double;
    ];
  mcl:derived [
    mcl:onDomain bikes:WeatherMetrics, mcl:Geolocation;
    mcl:query """
?ctx a bikes:BikeShareEventsAggregate;
    bikes:hourSlot ?hourSlot;
    mcl:locatedAt ?locatedAt;
    bikes:temperature ?temperature;
    bikes:relativeHumidity ?relativeHumidity;
    bikes:precipitation ?precipitation;
    bikes:windSpeed ?windSpeed;
    bikes:cloudCoverage ?cloudCoverage;
    bikes:airPressure ?airPressure;
    bikes:isHoliday ?isHoliday;
    bikes:isWeekend ?isWeekend;
    bikes:month ?month;
    bikes:hour ?hour;
    mcl:latitude ?latitude;
    mcl:longitude ?longitude;
    .
"""];
  .

bikes:hourSlot a owl:DatatypeProperty;
  rdfs:range xsd:dateTimeStamp;
  .

bikes:BikeShareStation a owl:Class;
  rdfs:subClassOf
    tlc:Location,
    [
      a mcl:WithAttribute;
      mcl:onProperty rdfs:label;
      mcl:onRange xsd:string;
      mcl:isKey true ;
    ];
  .

bikes:BikeShareEvent a owl:Class;
  rdfs:subClassOf
    tlc:Event,
    [ a mcl:WithAttribute ;
      mcl:onProperty mcl:acquiredAt ;
      mcl:onRange xsd:dateTimeStamp ;
      mcl:isKey true ;
    ],
    bikes:LocatedAtStation;
  .

bikes:WeatherMetrics a owl:Class;
  rdfs:subClassOf
    tlc:State,
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:hourSlot;
      mcl:onRange xsd:dateTimeStamp;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:temperature;
      mcl:onRange xsd:double;
      mcl:referenceUnit unit:degreeCelsius;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:relativeHumidity;
      mcl:onRange xsd:double;
      mcl:referenceUnit unit:percent;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:precipitation;
      mcl:onRange xsd:double;
      mcl:referenceUnit unit:millimetre;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:windSpeed;
      mcl:onRange xsd:double;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:cloudCoverage;
      mcl:onRange xsd:double;
    ],
    [
      a mcl:WithAttribute;
      mcl:onProperty bikes:airPressure;
      mcl:onRange xsd:double;
    ];
    # [
    #   a mcl:WithAttribute;
    #   mcl:onProperty bikes:weatherCondition;
    #   mcl:onRange bikes:WeatherCode;
    # ];
  .

bikes:LocatedAtStation a mcl:WithAttribute;
  mcl:onProperty mcl:locatedAt;
  mcl:onRange bikes:Station;
  mcl:isKey true;
  .

bikes:WeatherCode a owl:Class;
  owl:hasKey ( bikes:code );
  .

bikes:ClearWeather a bikes:WeatherCode; bikes:code 1.
bikes:FairWeather a bikes:WeatherCode; bikes:code 2.
bikes:CloudyWeather a bikes:WeatherCode; bikes:code 3.
bikes:OvercastWeather a bikes:WeatherCode; bikes:code 4.
bikes:FogWeather a bikes:WeatherCode; bikes:code 5.
bikes:FreezingFogWeather a bikes:WeatherCode; bikes:code 6.
bikes:LightRainWeather a bikes:WeatherCode; bikes:code 7.
bikes:RainWeather a bikes:WeatherCode; bikes:code 8.
bikes:HeavyRainWeather a bikes:WeatherCode; bikes:code 9.
bikes:FreezingRainWeather a bikes:WeatherCode; bikes:code 10.
bikes:HeavyFreezingRainWeather a bikes:WeatherCode; bikes:code 11.
bikes:SleetWeather a bikes:WeatherCode; bikes:code 12.
bikes:HeavySleetWeather a bikes:WeatherCode; bikes:code 13.
bikes:LightSnowfallWeather a bikes:WeatherCode; bikes:code 14.
bikes:SnowfallWeather a bikes:WeatherCode; bikes:code 15.
bikes:HeavySnowfallWeather a bikes:WeatherCode; bikes:code 16.
bikes:RainShowerWeather a bikes:WeatherCode; bikes:code 17.
bikes:HeavyRainShowerWeather a bikes:WeatherCode; bikes:code 18.
bikes:SleetShowerWeather a bikes:WeatherCode; bikes:code 19.
bikes:HeavySleetShowerWeather a bikes:WeatherCode; bikes:code 20.
bikes:SnowShowerWeather a bikes:WeatherCode; bikes:code 21.
bikes:HeavySnowShowerWeather a bikes:WeatherCode; bikes:code 22.
bikes:LightningWeather a bikes:WeatherCode; bikes:code 23.
bikes:HailWeather a bikes:WeatherCode; bikes:code 24.
bikes:ThunderstormWeather a bikes:WeatherCode; bikes:code 25.
bikes:HeavyThunderstormWeather a bikes:WeatherCode; bikes:code 26.
bikes:StormWeather a bikes:WeatherCode; bikes:code 27.
